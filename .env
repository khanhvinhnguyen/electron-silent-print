NODE_ENV=production

# Remote UI Configuration
REMOTE_UI_URL=https://fe.uniqlo.tabworki.com/
REMOTE_UI_FALLBACK=https://fallback.yourdomain.com

# Security - Comma separated list of allowed domains
ALLOWED_DOMAINS=http://localhost:5173,https://fe.uniqlo.tabworki.com/

# Debug settings
ENABLE_DEVTOOLS=false
DEBUG_LOGS=false

# App settings
APP_NAME=Uniqlo Chibi

# Print settings
DEFAULT_PRINTER=
PRINT_TIMEOUT=30000

# Development settings
HMR_ENABLED=false
VITE_DEV_SERVER=https://fe.uniqlo.tabworki.com/