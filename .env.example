NODE_ENV=development

# Remote UI Configuration
REMOTE_UI_URL=https://invisalign.marvy-uat.space
REMOTE_UI_FALLBACK=https://invisalign.marvy-uat.space

# Security - Comma separated list of allowed domains
ALLOWED_DOMAINS=http://localhost:5173,https://invisalign.marvy-uat.space

# Debug settings
ENABLE_DEVTOOLS=false
DEBUG_LOGS=false

# App settings
APP_NAME=Uniqlo Chibi

# Print settings
DEFAULT_PRINTER=
PRINT_TIMEOUT=5000

# Development settings
HMR_ENABLED=true
VITE_DEV_SERVER=https://invisalign.marvy-uat.space